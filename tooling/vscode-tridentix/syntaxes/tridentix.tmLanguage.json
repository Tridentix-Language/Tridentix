{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tridentix",
  "scopeName": "source.trix",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.trix",
          "match": "#.*$"
        },
        {
          "name": "comment.block.trix",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.trix",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.trix",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.trix",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.trix",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.trix",
          "match": "\\b(if|elif|else|loop|while|match|return|try|catch|raise|in)\\b"
        },
        {
          "name": "keyword.declaration.trix",
          "match": "\\b(fn|let|mut|const|actor|supervisor|import|as)\\b"
        },
        {
          "name": "keyword.concurrency.trix",
          "match": "\\b(spawn|send|on|receive)\\b"
        },
        {
          "name": "keyword.operator.logical.trix",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.trix",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.wildcard.trix",
          "match": "\\b_\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.trix",
          "match": "\\b(int|float|string|bool|tensor|vector|graph|dataset|model)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.trix",
          "match": "\\b(?<=fn\\s)[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "support.function.builtin.trix",
          "match": "\\b(print|tensor|len|str_upper|str_lower|str_split|str_trim|str_contains|int_to_str|str_to_int|list_push|list_get|range_list|borrow|borrow_mut)\\b"
        },
        {
          "name": "entity.name.type.class.trix",
          "match": "\\b(?<=actor\\s|supervisor\\s|spawn\\s)[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.trix",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.trix",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.trix",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.trix",
          "match": "\\+|\\-|\\*|/"
        }
      ]
    }
  }
}
